{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "refresh_reference": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Refresh Reference"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "bbox_normalized": {
            "anyOf": [
              {
                "maxItems": 4,
                "minItems": 4,
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Bbox Normalized"
          },
          "confidence_label": {
            "enum": [
              "high",
              "review",
              "low"
            ],
            "title": "Confidence Label",
            "type": "string"
          },
          "extracted_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extracted Value"
          },
          "field_path": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Field Path",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page"
          },
          "region_quality": {
            "enum": [
              "exact",
              "approximate",
              "full_page",
              "text"
            ],
            "title": "Region Quality",
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "text_span": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text Span"
          }
        },
        "required": [
          "field_path",
          "source_id",
          "region_quality",
          "confidence_label",
          "extracted_value"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "Identity": {
        "additionalProperties": false,
        "properties": {
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/Membership"
            },
            "title": "Memberships",
            "type": "array"
          },
          "networks": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/NetworkAccess"
            },
            "title": "Networks",
            "type": "array"
          },
          "subject": {
            "format": "uuid",
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "memberships"
        ],
        "title": "Identity",
        "type": "object"
      },
      "Membership": {
        "additionalProperties": false,
        "properties": {
          "business_id": {
            "format": "uuid",
            "title": "Business Id",
            "type": "string"
          },
          "can_view_prices": {
            "title": "Can View Prices",
            "type": "boolean"
          },
          "locale": {
            "enum": [
              "en",
              "ms",
              "zh"
            ],
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "staff"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "business_id",
          "name",
          "role",
          "locale",
          "can_view_prices"
        ],
        "title": "Membership",
        "type": "object"
      },
      "Mutation": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 1,
            "title": "Expected Revision",
            "type": "integer"
          }
        },
        "required": [
          "expected_revision"
        ],
        "title": "Mutation",
        "type": "object"
      },
      "NetworkAccess": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "network_id": {
            "format": "uuid",
            "title": "Network Id",
            "type": "string"
          },
          "role": {
            "const": "network_admin",
            "default": "network_admin",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "network_id",
          "name"
        ],
        "title": "NetworkAccess",
        "type": "object"
      },
      "PoolOffer": {
        "additionalProperties": false,
        "properties": {
          "agreed_delivered_cost": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Agreed Delivered Cost",
            "type": "string"
          },
          "approval_state": {
            "enum": [
              "not_approved",
              "valid",
              "void",
              "expired",
              "withdrawn",
              "released"
            ],
            "title": "Approval State",
            "type": "string"
          },
          "base_unit": {
            "enum": [
              "piece",
              "ml",
              "g"
            ],
            "title": "Base Unit",
            "type": "string"
          },
          "credit_days": {
            "minimum": 0,
            "title": "Credit Days",
            "type": "integer"
          },
          "current_solo_comparable_cost": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Current Solo Comparable Cost",
            "type": "string"
          },
          "decision_delivered_cost": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Decision Delivered Cost",
            "type": "string"
          },
          "eligibility": {
            "enum": [
              "eligible",
              "ineligible",
              "unavailable"
            ],
            "title": "Eligibility",
            "type": "string"
          },
          "evaluated_at": {
            "format": "date-time",
            "title": "Evaluated At",
            "type": "string"
          },
          "evaluation_revision": {
            "minimum": 1,
            "title": "Evaluation Revision",
            "type": "integer"
          },
          "expected_delivered_cost": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Expected Delivered Cost",
            "type": "string"
          },
          "failure_codes": {
            "items": {
              "type": "string"
            },
            "title": "Failure Codes",
            "type": "array"
          },
          "historical_comparable_cost": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Historical Comparable Cost",
            "type": "string"
          },
          "historical_saving": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Historical Saving",
            "type": "string"
          },
          "member_count": {
            "minimum": 1,
            "title": "Member Count",
            "type": "integer"
          },
          "own_quantity": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Own Quantity",
            "type": "string"
          },
          "pool_id": {
            "format": "uuid",
            "title": "Pool Id",
            "type": "string"
          },
          "pooling_saving": {
            "pattern": "^-?\\d+(\\.\\d{1,6})?$",
            "title": "Pooling Saving",
            "type": "string"
          },
          "release_state": {
            "enum": [
              "waiting_for_approvals",
              "ready",
              "released",
              "ineligible"
            ],
            "title": "Release State",
            "type": "string"
          }
        },
        "required": [
          "pool_id",
          "evaluation_revision",
          "evaluated_at",
          "own_quantity",
          "base_unit",
          "agreed_delivered_cost",
          "expected_delivered_cost",
          "decision_delivered_cost",
          "historical_comparable_cost",
          "current_solo_comparable_cost",
          "historical_saving",
          "pooling_saving",
          "credit_days",
          "member_count",
          "eligibility",
          "failure_codes",
          "approval_state",
          "release_state"
        ],
        "title": "PoolOffer",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Orbyte Collective",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
